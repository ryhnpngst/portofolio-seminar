---
import { profile } from "../../data/profile";
import Container from "../common/Container.astro";
import SectionHeader from "../common/SectionHeader.astro";
import { Compass, HeartHandshake, Laptop, Lightbulb } from "lucide-astro";

const iconMap = {
  Compass,
  HeartHandshake,
  Laptop,
  Lightbulb,
};
---

<section class="py-16 md:py-24 bg-stone-50 border-b border-stone-200/70">
  <Container>
    <div class="max-w-[760px] mx-auto text-center mb-12">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-stone-900 font-display mb-3">
        Empat Pilar Filosofi Mengajar
      </h2>
      <p class="text-base sm:text-lg text-stone-600 leading-relaxed">
        Prinsip dasar yang memandu setiap keputusan instruksional, penyusunan perangkat ajar, dan interaksi saya bersama peserta didik di ruang kelas.
      </p>
    </div>

    <!-- 2x2 Tenet Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {profile.philosophyTenets.map((tenet) => {
        const IconComponent = iconMap[tenet.iconName as keyof typeof iconMap] || Compass;
        return (
          <div class="p-8 rounded-[20px] bg-white border border-stone-200/80 flex flex-col justify-between transition-all duration-200 hover:border-emerald-300 hover:shadow-xs">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="text-2xl font-bold text-emerald-600/40 font-display tracking-tight">
                  {tenet.number}
                </span>
                <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center">
                  <IconComponent class="w-5 h-5" />
                </div>
              </div>

              <h3 class="text-xs font-semibold uppercase tracking-wider text-emerald-700 mb-1.5">
                {tenet.title}
              </h3>
              <h4 class="text-lg font-bold text-stone-900 font-display mb-3">
                {tenet.headline}
              </h4>
              <p class="text-sm text-stone-600 leading-relaxed">
                {tenet.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-stone-100 flex items-center text-xs font-medium text-stone-400">
              <span>Landasan Pedagogis PPG Calon Guru</span>
            </div>
          </div>
        );
      })}
    </div>
  </Container>
</section>

