---
import { profile } from "../../data/profile";
import Container from "../common/Container.astro";
import { Sparkles, Quote } from "lucide-astro";
---

<section class="py-16 md:py-24 bg-white border-b border-stone-200/70">
  <Container>
    <div class="max-w-[760px] mx-auto">
      <!-- Section Header -->
      <div class="mb-10 text-center">
        <span class="text-xs font-semibold tracking-wider text-emerald-700 uppercase mb-2 block">
          LATAR BELAKANG & MOTIVASI
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-stone-900 font-display">
          {profile.journeyStory.title}
        </h2>
      </div>

      <!-- Narrative Article Body -->
      <div class="prose prose-stone max-w-none text-stone-700 leading-[1.85] text-base sm:text-lg space-y-6">
        <p>
          {profile.journeyStory.paragraphs[0]}
        </p>

        <!-- Editorial Pullquote -->
        <div class="my-8 p-6 rounded-2xl bg-stone-50 border-l-4 border-emerald-600 shadow-2xs">
          <div class="flex items-start gap-3">
            <Quote class="w-6 h-6 text-emerald-600 shrink-0 mt-1" />
            <p class="italic text-base sm:text-lg font-medium text-stone-800 leading-relaxed m-0">
              "Dampak terbesar terjadi ketika manusia di balik teknologi tersebut memiliki karakter luhur, daya nalar kritis, dan kebijaksanaan dalam memanfaatkannya bagi kemaslahatan bersama."
            </p>
          </div>
        </div>

        <p>
          {profile.journeyStory.paragraphs[1]}
        </p>

        <p>
          {profile.journeyStory.paragraphs[2]}
        </p>
      </div>
    </div>
  </Container>
</section>

