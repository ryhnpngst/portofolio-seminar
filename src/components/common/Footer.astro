---
import { profile } from "../../data/profile";
import { footerNavItems } from "../../data/navigation";
import Container from "./Container.astro";

const currentYear = new Date().getFullYear();
---

<footer class="bg-stone-900 text-stone-300 mt-auto border-t border-stone-800">
  <Container class="py-14 lg:py-16">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-10 lg:gap-16">
      <!-- Profile Column -->
      <div class="max-w-[45ch]">
        <p class="text-sm text-stone-400 leading-relaxed">
          Portofolio digital dokumentasi pembelajaran, refleksi kritis, dan karya inovatif selama menempuh program Pendidikan Profesi Guru.
        </p>
      </div>

      <!-- Navigation Links -->
      <div class="shrink-0">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-400 mb-4">
          Navigasi Halaman
        </h3>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 sm:gap-x-12 gap-y-2.5">
          {footerNavItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-stone-300 hover:text-emerald-400 transition-colors inline-flex items-center gap-1 group"
              >
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 pt-8 border-t border-stone-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>© {currentYear} {profile.name}</p>
    </div>
  </Container>
</footer>
