---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  class: className = "",
} = Astro.props;

const alignmentClass = align === "center" ? "text-center mx-auto items-center" : "text-left items-start";
---

<div class={`flex flex-col mb-10 md:mb-14 ${alignmentClass} ${className}`}>
  {eyebrow && (
    <span class="text-xs md:text-sm font-semibold tracking-wider text-emerald-700 uppercase mb-2">
      {eyebrow}
    </span>
  )}
  <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-stone-900 font-display">
    {title}
  </h2>
  {description && (
    <p class="mt-3 md:mt-4 text-base md:text-lg text-stone-600 leading-relaxed max-w-[65ch]">
      {description}
    </p>
  )}
</div>

