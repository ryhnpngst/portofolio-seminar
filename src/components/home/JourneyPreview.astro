---
import { journeySteps } from "../../data/journey";
import Container from "../common/Container.astro";
import SectionHeader from "../common/SectionHeader.astro";
import Button from "../common/Button.astro";
import { ArrowRight, CheckCircle2 } from "lucide-astro";
---

<section class="py-16 md:py-24 bg-white border-b border-stone-200/70">
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <SectionHeader
        eyebrow="TIMELINE BELAJAR"
        title="Perjalanan Program PPG Calon Guru"
        description="Kronologi pembelajaran terstruktur dari pembentukan pemahaman teoritis hingga penerapan praktis mandiri di sekolah mitra."
        class="mb-0!"
      />
      <div class="mt-4 md:mt-0">
        <Button href="/perjalanan" variant="secondary" size="md">
          <span>Lihat Perjalanan Lengkap</span>
          <ArrowRight class="w-4 h-4 ml-2" />
        </Button>
      </div>
    </div>

    <!-- Timeline Grid / Flow -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-4 lg:gap-6 relative">
      {journeySteps.map((step, index) => {
        const isLast = index === journeySteps.length - 1;
        return (
          <div
            class={`relative flex flex-col p-6 rounded-[16px] border transition-all duration-200 group ${
              step.highlight
                ? "bg-emerald-50/50 border-emerald-300 hover:border-emerald-500 shadow-xs"
                : "bg-stone-50/70 border-stone-200 hover:border-stone-300 hover:bg-white"
            }`}
          >
            <!-- Step Marker Header -->
            <div class="flex items-center justify-between mb-4">
              <span
                class={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold font-display ${
                  step.highlight
                    ? "bg-emerald-600 text-white"
                    : "bg-stone-200 text-stone-700 group-hover:bg-emerald-100 group-hover:text-emerald-800 transition-colors"
                }`}
              >
                {step.stepNumber}
              </span>
              <span class="text-xs font-semibold text-stone-500 uppercase tracking-wider">
                {step.period}
              </span>
            </div>

            <!-- Title & Stage -->
            <h3 class="text-base font-bold text-stone-900 font-display mb-1">
              {step.title}
            </h3>
            <p class="text-xs font-semibold text-emerald-700 mb-3">
              {step.stage}
            </p>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed mb-6 flex-1">
              {step.description}
            </p>

            <!-- Step Link -->
            <a
              href={step.link}
              class="inline-flex items-center gap-1 text-xs font-semibold text-stone-700 group-hover:text-emerald-700 transition-colors mt-auto pt-3 border-t border-stone-200/60"
            >
              <span>{step.linkLabel}</span>
              <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
            </a>
          </div>
        );
      })}
    </div>
  </Container>
</section>

