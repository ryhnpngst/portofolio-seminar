---
import { profile } from "../../data/profile";
import Container from "../common/Container.astro";
import { Quote } from "lucide-astro";
---

<section class="py-20 md:py-28 bg-emerald-900 text-white relative overflow-hidden">
  <!-- Subtle pattern / glow background -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-emerald-800/50 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-emerald-950/60 rounded-full blur-3xl pointer-events-none"></div>

  <Container class="relative z-10">
    <div class="max-w-[800px] mx-auto text-center flex flex-col items-center">
      <div class="w-12 h-12 rounded-full bg-emerald-800/80 border border-emerald-700 flex items-center justify-center text-emerald-300 mb-8">
        <Quote class="w-6 h-6" />
      </div>

      <blockquote class="text-xl sm:text-2xl md:text-3xl font-medium tracking-tight leading-snug font-display text-emerald-50 mb-8">
        "{profile.philosophy.quote}"
      </blockquote>

      <div class="flex flex-col items-center">
        <cite class="not-italic text-base font-bold text-white font-display">
          {profile.philosophy.author}
        </cite>
        <span class="text-xs text-emerald-300 mt-1 uppercase tracking-wider font-medium">
          {profile.role} · {profile.field}
        </span>
      </div>
    </div>
  </Container>
</section>
