---
import Container from "../common/Container.astro";
import Badge from "../common/Badge.astro";
import { Milestone, BookOpen, School, Award } from "lucide-astro";
---

<section class="pt-8 md:pt-14 pb-12 md:pb-16 bg-stone-50 border-b border-stone-200/70">
  <Container>
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-stone-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-emerald-700 transition-colors">Beranda</a>
      <span>/</span>
      <span class="text-stone-800 font-medium">Perjalanan PPG</span>
    </nav>

    <div class="max-w-[840px]">
      <div class="inline-flex items-center gap-2 mb-3">
        <Badge variant="primary" size="sm">
          KRONOLOGI BELAJAR
        </Badge>
        <span class="text-xs font-semibold text-stone-500 uppercase tracking-wider">
          Informatika
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-stone-900 tracking-tight leading-[1.15] font-display mb-4">
        Perjalanan Program PPG Calon Guru
      </h1>

      <p class="text-base sm:text-lg text-stone-600 leading-relaxed mb-8">
        Rekam jejak kronologis transformasi calon guru Informatika dari Semester 1, praktik pembelajaran terbimbing di sekolah mitra, pendalaman inovasi Semester 2, praktik mandiri penuh, hingga sintesis peneguhan identitas guru profesional.
      </p>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-stone-200/80">
        <div class="flex items-center gap-3 p-3 rounded-xl bg-white border border-stone-200/80">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0">
            <Milestone class="w-4 h-4" />
          </div>
          <div>
            <p class="text-xs text-stone-500 font-medium">Tahapan</p>
            <p class="text-xs sm:text-sm font-bold text-stone-900">5 Fase Belajar</p>
          </div>
        </div>

        <div class="flex items-center gap-3 p-3 rounded-xl bg-white border border-stone-200/80">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0">
            <BookOpen class="w-4 h-4" />
          </div>
          <div>
            <p class="text-xs text-stone-500 font-medium">Perkuliahan</p>
            <p class="text-xs sm:text-sm font-bold text-stone-900">2 Semester</p>
          </div>
        </div>

        <div class="flex items-center gap-3 p-3 rounded-xl bg-white border border-stone-200/80">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0">
            <School class="w-4 h-4" />
          </div>
          <div>
            <p class="text-xs text-stone-500 font-medium">Praktik Lapangan</p>
            <p class="text-xs sm:text-sm font-bold text-stone-900">PPL I & PPL II</p>
          </div>
        </div>

        <div class="flex items-center gap-3 p-3 rounded-xl bg-white border border-stone-200/80">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0">
            <Award class="w-4 h-4" />
          </div>
          <div>
            <p class="text-xs text-stone-500 font-medium">Penutup</p>
            <p class="text-xs sm:text-sm font-bold text-stone-900">Refleksi Akhir</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

