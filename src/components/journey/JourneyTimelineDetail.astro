---
import { journeySteps } from "../../data/journey";
import Container from "../common/Container.astro";
import Badge from "../common/Badge.astro";
import Button from "../common/Button.astro";
import { ArrowRight, CheckCircle2, Quote, BookOpen } from "lucide-astro";
---

<section class="py-16 md:py-24 bg-white border-b border-stone-200/70">
  <Container>
    <div class="max-w-[840px] mx-auto">
      <!-- Section Title -->
      <div class="mb-14 text-center">
        <span class="text-xs font-semibold tracking-wider text-emerald-700 uppercase mb-2 block">
          ALUR KRONOLOGIS
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-stone-900 font-display">
          Lima Tahapan Transformasi Calon Guru
        </h2>
        <p class="mt-3 text-base text-stone-600 max-w-[60ch] mx-auto leading-relaxed">
          Setiap fase memiliki target kompetensi, dinamika praktik lapangan, serta refleksi kritis yang saling menguatkan.
        </p>
      </div>

      <!-- Vertical Timeline Wrapper -->
      <div class="relative pl-6 sm:pl-10 space-y-12 sm:space-y-16">
        <!-- Connecting Vertical Line -->
        <div
          class="absolute left-[15px] sm:left-[23px] top-6 bottom-6 w-0.5 bg-gradient-to-b from-emerald-500 via-emerald-600 to-teal-600"
          aria-hidden="true"
        ></div>

        {journeySteps.map((step) => (
          <div class="relative group">
            <!-- Step Marker Dot -->
            <div
              class={`absolute -left-[23px] sm:-left-[39px] top-1.5 w-8 h-8 sm:w-9 sm:h-9 rounded-full flex items-center justify-center font-bold text-xs sm:text-sm font-display ring-4 ring-white shadow-xs transition-transform duration-200 group-hover:scale-110 ${
                step.highlight
                  ? "bg-emerald-600 text-white"
                  : "bg-emerald-100 text-emerald-800"
              }`}
            >
              {step.stepNumber}
            </div>

            <!-- Milestone Card -->
            <div
              class={`rounded-[20px] border p-6 sm:p-8 transition-all duration-200 ${
                step.highlight
                  ? "bg-emerald-50/40 border-emerald-300 shadow-xs"
                  : "bg-stone-50/70 border-stone-200 hover:border-emerald-200 hover:bg-white hover:shadow-xs"
              }`}
            >
              <!-- Card Header -->
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">
                  {step.period}
                </span>
                {step.badge && (
                  <Badge variant={step.highlight ? "primary" : "neutral"} size="sm">
                    {step.badge}
                  </Badge>
                )}
              </div>

              <!-- Title & Stage -->
              <h3 class="text-xl sm:text-2xl font-bold text-stone-900 font-display mb-1">
                {step.title}
              </h3>
              <p class="text-sm font-semibold text-emerald-700 mb-4">
                {step.stage}
              </p>

              <!-- Description -->
              <p class="text-sm sm:text-base text-stone-600 leading-relaxed mb-6">
                {step.fullDescription || step.description}
              </p>

              <!-- Thumbnail Image (if present) -->
              {step.image && (
                <div class="relative aspect-[16/9] w-full rounded-xl overflow-hidden border border-stone-200/80 mb-6 bg-stone-100">
                  <img
                    src={step.image}
                    alt={step.imageAlt || step.title}
                    loading="lazy"
                    class="w-full h-full object-cover"
                  />
                </div>
              )}

              <!-- Key Experiences List -->
              {step.keyExperiences && step.keyExperiences.length > 0 && (
                <div class="mb-6 pt-4 border-t border-stone-200/60">
                  <h4 class="text-xs font-semibold uppercase tracking-wider text-stone-500 mb-3">
                    Pengalaman & Aktivitas Utama
                  </h4>
                  <ul class="space-y-2">
                    {step.keyExperiences.map((exp) => (
                      <li class="flex items-start gap-2.5 text-xs sm:text-sm text-stone-700 leading-relaxed">
                        <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                        <span>{exp}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Key Takeaways Quote Box -->
              {step.keyTakeaways && (
                <div class="mb-6 p-4 rounded-xl bg-white border-l-3 border-emerald-600 border border-stone-200/80 shadow-2xs">
                  <div class="flex items-start gap-2.5">
                    <Quote class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-wider text-emerald-800 mb-1">
                        Pembelajaran Bermakna
                      </p>
                      <p class="italic text-xs sm:text-sm text-stone-700 leading-relaxed m-0">
                        "{step.keyTakeaways}"
                      </p>
                    </div>
                  </div>
                </div>
              )}

              <!-- Related Courses & Action Link -->
              <div class="pt-4 border-t border-stone-200/60 flex flex-wrap items-center justify-between gap-4">
                {step.relatedCourses && step.relatedCourses.length > 0 && (
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-xs text-stone-400 font-medium mr-1 flex items-center gap-1">
                      <BookOpen class="w-3.5 h-3.5 text-stone-400" />
                      Terkait:
                    </span>
                    {step.relatedCourses.map((c) => (
                      <span class="text-xs text-stone-600 bg-white px-2 py-0.5 rounded-md border border-stone-200">
                        {c.name}
                      </span>
                    ))}
                  </div>
                )}

                <Button href={step.link} variant="text" class="text-xs sm:text-sm font-semibold ml-auto">
                  <span>{step.linkLabel}</span>
                  <ArrowRight class="w-3.5 h-3.5 ml-1" />
                </Button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

