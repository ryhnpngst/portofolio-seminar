---
import { ArrowLeft, ArrowRight, Grid } from "lucide-astro";

interface NavEntry {
  title: string;
  slug: string;
  semester: number;
}

interface Props {
  prev?: NavEntry;
  next?: NavEntry;
  class?: string;
}

const { prev, next, class: className = "" } = Astro.props;
---

<nav
  class={`pt-10 mt-12 border-t border-stone-200/80 flex flex-col sm:flex-row items-center justify-between gap-4 ${className}`}
  aria-label="Navigasi Artikel Refleksi"
>
  <!-- Previous Reflection Link -->
  <div class="w-full sm:w-1/3 text-left">
    {prev ? (
      <a
        href={`/refleksi/${prev.slug}`}
        class="group flex flex-col items-start p-3.5 rounded-xl border border-stone-200/70 bg-stone-50/50 hover:bg-stone-50 hover:border-emerald-300 transition-all"
      >
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1 group-hover:text-emerald-700">
          <ArrowLeft class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1" />
          <span>Refleksi Sebelumnya</span>
        </span>
        <span class="text-xs sm:text-sm font-bold text-stone-900 line-clamp-1 group-hover:text-emerald-700">
          {prev.title}
        </span>
      </a>
    ) : (
      <div class="hidden sm:block"></div>
    )}
  </div>

  <!-- Center: Back to All Reflections -->
  <div class="w-full sm:w-auto text-center">
    <a
      href="/refleksi"
      class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-stone-700 bg-white border border-stone-200 hover:bg-stone-50 hover:border-stone-300 transition-all"
    >
      <Grid class="w-4 h-4 text-emerald-600" />
      <span>Semua Refleksi</span>
    </a>
  </div>

  <!-- Next Reflection Link -->
  <div class="w-full sm:w-1/3 text-right">
    {next ? (
      <a
        href={`/refleksi/${next.slug}`}
        class="group flex flex-col items-end p-3.5 rounded-xl border border-stone-200/70 bg-stone-50/50 hover:bg-stone-50 hover:border-emerald-300 transition-all"
      >
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1 group-hover:text-emerald-700">
          <span>Refleksi Berikutnya</span>
          <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
        </span>
        <span class="text-xs sm:text-sm font-bold text-stone-900 line-clamp-1 group-hover:text-emerald-700">
          {next.title}
        </span>
      </a>
    ) : (
      <div class="hidden sm:block"></div>
    )}
  </div>
</nav>

