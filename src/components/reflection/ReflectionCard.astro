---
import type { FeaturedReflection } from "../../data/featured";
import Badge from "../common/Badge.astro";
import { ArrowRight } from "lucide-astro";

interface Props {
  reflection: FeaturedReflection;
  class?: string;
}

const { reflection, class: className = "" } = Astro.props;
---

<article
  class={`group flex flex-col bg-white border border-stone-200 rounded-[16px] overflow-hidden transition-all duration-250 hover:border-emerald-300 hover:-translate-y-1 hover:shadow-sm ${className}`}
>
  <!-- Thumbnail Image -->
  <div class="relative aspect-[16/9] w-full overflow-hidden bg-stone-100">
    <img
      src={reflection.image}
      alt={reflection.imageAlt}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute top-3 left-3">
      <Badge variant="primary" size="sm">
        Semester {reflection.semester}
      </Badge>
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 flex flex-col flex-1">
    <h3 class="text-lg font-bold text-stone-900 tracking-tight font-display mb-2 group-hover:text-emerald-700 transition-colors">
      <a href={`/refleksi/${reflection.slug}`} class="focus:outline-none">
        {reflection.title}
      </a>
    </h3>

    <p class="text-sm text-stone-600 leading-relaxed mb-6 flex-1 line-clamp-3">
      {reflection.description}
    </p>

    <!-- Footer Action -->
    <div class="pt-4 border-t border-stone-100 flex items-center justify-between mt-auto">
      <div class="flex flex-wrap gap-1.5">
        {reflection.tags.slice(0, 2).map((tag) => (
          <span class="text-xs text-stone-500 bg-stone-50 px-2 py-0.5 rounded border border-stone-200/60">
            {tag}
          </span>
        ))}
      </div>
      <a
        href={`/refleksi/${reflection.slug}`}
        class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 hover:text-emerald-800 transition-colors group-hover:translate-x-0.5"
        aria-label={`Baca refleksi tentang ${reflection.title}`}
      >
        <span>Baca Refleksi</span>
        <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</article>

