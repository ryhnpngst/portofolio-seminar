---
import type { ReflectionSection } from "../../utils/reflectionParser";
import { Sparkles, FolderCheck } from "lucide-astro";

interface Props {
  sections: ReflectionSection[];
}

const { sections } = Astro.props;
---

<nav
  aria-label="Navigasi Indikator Refleksi"
  class="sticky top-20 z-10 mb-10 p-2 sm:p-2.5 bg-stone-50/95 backdrop-blur-md rounded-2xl border border-stone-200/90 shadow-xs"
>
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2 text-xs">
    <span class="text-stone-500 font-semibold px-2 py-1 hidden lg:inline">
      Lompat ke Indikator:
    </span>

    <div class="flex flex-wrap items-center gap-2 flex-1">
      {sections.map((sec, idx) => {
        const Icon = sec.type === "4c" ? Sparkles : FolderCheck;
        return (
          <a
            href={`#${sec.id}`}
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl bg-white border border-stone-200 text-stone-700 font-semibold hover:border-emerald-300 hover:text-emerald-800 hover:bg-emerald-50/50 transition-colors shadow-2xs text-center"
          >
            <Icon class="w-3.5 h-3.5 text-emerald-700" />
            <span>Indikator {idx + 1}: {sec.title}</span>
            <span class="px-1.5 py-0.5 rounded-md bg-stone-100 text-[11px] font-bold text-stone-600">
              {sec.items.length}
            </span>
          </a>
        );
      })}
    </div>
  </div>
</nav>
