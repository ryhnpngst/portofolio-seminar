---
import type { ReflectionSection } from "../../utils/reflectionParser";
import ReflectionQuestionCard from "./ReflectionQuestionCard.astro";
import { BookOpen, FolderCheck, Sparkles } from "lucide-astro";

interface Props {
  section: ReflectionSection;
}

const { section } = Astro.props;

const is4C = section.type === "4c";
const SectionIcon = is4C ? Sparkles : FolderCheck;
---

<section id={section.id} class="scroll-mt-24 mb-14 md:mb-18">
  <!-- Indicator Section Header -->
  <div class="mb-6 pb-4 border-b border-stone-200">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2.5">
      <div class="inline-flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-emerald-100 text-emerald-900 border border-emerald-300">
          <SectionIcon class="w-3.5 h-3.5 text-emerald-700" />
          <span>{section.badge}</span>
        </span>
        <span class="text-xs font-semibold text-stone-500 uppercase tracking-wider">
          {section.items.length} Pertanyaan Reflektif
        </span>
      </div>

      <span class="text-xs font-medium text-stone-500">
        {section.subtitle}
      </span>
    </div>

    <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-stone-900 tracking-tight font-display mb-2">
      {section.title}
    </h2>

    <p class="text-sm sm:text-base text-stone-600 leading-relaxed max-w-[70ch]">
      {section.description}
    </p>
  </div>

  <!-- Cards List -->
  <div class="grid grid-cols-1 gap-5 md:gap-6">
    {section.items.map((item) => (
      <ReflectionQuestionCard item={item} />
    ))}
  </div>
</section>
