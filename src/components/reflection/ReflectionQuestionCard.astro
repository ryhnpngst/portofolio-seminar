---
import type { ReflectionItem } from "../../utils/reflectionParser";
import {
  Compass,
  AlertCircle,
  BookOpen,
  Sparkles,
  FolderCheck,
  CheckCircle2,
  Target,
  MessageSquare,
  HelpCircle,
} from "lucide-astro";

interface Props {
  item: ReflectionItem;
}

const { item } = Astro.props;

// Determine badge color palette based on item.color
const colorClasses: Record<string, { badge: string; pill: string; icon: any; border: string }> = {
  emerald: {
    badge: "bg-emerald-50 text-emerald-800 border-emerald-200",
    pill: "bg-emerald-600 text-white",
    icon: Compass,
    border: "hover:border-emerald-300",
  },
  amber: {
    badge: "bg-amber-50 text-amber-900 border-amber-200",
    pill: "bg-amber-600 text-white",
    icon: AlertCircle,
    border: "hover:border-amber-300",
  },
  blue: {
    badge: "bg-sky-50 text-sky-900 border-sky-200",
    pill: "bg-sky-600 text-white",
    icon: BookOpen,
    border: "hover:border-sky-300",
  },
  purple: {
    badge: "bg-purple-50 text-purple-900 border-purple-200",
    pill: "bg-purple-600 text-white",
    icon: Sparkles,
    border: "hover:border-purple-300",
  },
  teal: {
    badge: "bg-teal-50 text-teal-900 border-teal-200",
    pill: "bg-teal-600 text-white",
    icon: FolderCheck,
    border: "hover:border-teal-300",
  },
  indigo: {
    badge: "bg-indigo-50 text-indigo-900 border-indigo-200",
    pill: "bg-indigo-600 text-white",
    icon: CheckCircle2,
    border: "hover:border-indigo-300",
  },
  rose: {
    badge: "bg-rose-50 text-rose-900 border-rose-200",
    pill: "bg-rose-600 text-white",
    icon: Target,
    border: "hover:border-rose-300",
  },
};

const currentStyle = colorClasses[item.color] || colorClasses.emerald;
const CategoryIcon = currentStyle.icon;
const formattedNumber = String(item.questionNumber).padStart(2, "0");
---

<div
  class:list={[
    "group/card bg-white rounded-2xl border border-stone-200/90 shadow-xs transition-all duration-200 overflow-hidden flex flex-col",
    currentStyle.border,
  ]}
>
  <!-- Card Header Strip -->
  <div class="px-5 sm:px-6 py-3.5 bg-stone-50/70 border-b border-stone-100 flex flex-wrap items-center justify-between gap-2.5">
    <div class="flex items-center gap-2">
      <!-- Category Badge -->
      <span
        class:list={[
          "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold tracking-wide uppercase border",
          currentStyle.badge,
        ]}
      >
        <CategoryIcon class="w-3.5 h-3.5" />
        <span>{item.category}</span>
      </span>

      <!-- Question Number Pill -->
      <span class="text-xs font-semibold text-stone-500 bg-white px-2 py-0.5 rounded-md border border-stone-200">
        Pertanyaan {formattedNumber}
      </span>
    </div>

    <!-- Category Description -->
    {item.categoryDescription && (
      <span class="text-xs font-medium text-stone-500 hidden sm:inline">
        {item.categoryDescription}
      </span>
    )}
  </div>

  <!-- Question Section -->
  <div class="px-5 sm:px-6 pt-5 pb-4">
    <div class="flex items-start gap-3">
      <div class="mt-0.5 p-1.5 rounded-lg bg-stone-100 text-stone-500 group-hover/card:bg-stone-200/70 transition-colors flex-shrink-0">
        <HelpCircle class="w-4 h-4 text-emerald-700" />
      </div>
      <h3 class="text-base sm:text-lg font-bold text-stone-900 tracking-tight leading-snug font-display">
        {item.question}
      </h3>
    </div>
  </div>

  <!-- Uraian Jawaban Body -->
  <div class="px-5 sm:px-6 pb-6 pt-1 flex-1 flex flex-col border-t border-stone-100/90 mt-1">
    <div class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-emerald-800 mt-3 mb-3">
      <MessageSquare class="w-3 h-3 text-emerald-600" />
      <span>Uraian Refleksi & Jawaban</span>
    </div>

    <!-- Optional Intro Narrative -->
    {item.intro && (
      <div class="mb-4 text-sm text-stone-700 bg-stone-50/80 p-3.5 rounded-xl border border-stone-200/60 leading-relaxed font-normal">
        {item.intro}
      </div>
    )}

    <!-- Points or Single Narrative -->
    {item.points.length > 1 ? (
      <ol class="space-y-3 flex-1">
        {item.points.map((point, idx) => (
          <li class="flex items-start gap-3 text-sm text-stone-700 leading-relaxed group/item">
            <span class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-stone-100 text-stone-700 font-bold text-xs border border-stone-200 mt-0.5 group-hover/item:bg-emerald-600 group-hover/item:text-white group-hover/item:border-emerald-600 transition-colors">
              {idx + 1}
            </span>
            <span class="flex-1 pt-0.5">
              {point}
            </span>
          </li>
        ))}
      </ol>
    ) : (
      <div class="text-sm text-stone-700 leading-relaxed flex-1">
        <p>{item.points[0] || item.rawAnswer}</p>
      </div>
    )}
  </div>
</div>
