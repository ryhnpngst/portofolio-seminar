---
import type { FeaturedWork } from "../../data/featured";
import Badge from "../common/Badge.astro";
import { ArrowUpRight } from "lucide-astro";

interface Props {
  work: FeaturedWork;
  class?: string;
}

const { work, class: className = "" } = Astro.props;

const isExternal = Boolean(work.externalUrl);
const targetUrl = work.externalUrl || work.link;
---

<article
  class={`group flex flex-col bg-white border border-stone-200 rounded-[16px] overflow-hidden transition-all duration-250 hover:border-emerald-300 hover:-translate-y-1 hover:shadow-sm ${className}`}
>
  <!-- Thumbnail Image -->
  <div class="relative aspect-[16/9] w-full overflow-hidden bg-stone-100">
    <img
      src={work.image}
      alt={work.imageAlt}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute top-3 left-3">
      <Badge variant="amber" size="sm">
        {work.category}
      </Badge>
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 flex flex-col flex-1">
    <h3 class="text-lg font-bold text-stone-900 tracking-tight font-display mb-2 group-hover:text-emerald-700 transition-colors">
      <a
        href={targetUrl}
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener noreferrer" : undefined}
        class="focus:outline-none inline-flex items-center gap-1"
      >
        <span>{work.title}</span>
        <ArrowUpRight class="w-4 h-4 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-emerald-600" />
      </a>
    </h3>

    <p class="text-sm text-stone-600 leading-relaxed mb-6 flex-1 line-clamp-3">
      {work.description}
    </p>

    <!-- Footer Tags & Action -->
    <div class="pt-4 border-t border-stone-100 flex items-center justify-between mt-auto">
      <div class="flex flex-wrap gap-1.5">
        {work.technologies.slice(0, 2).map((tech) => (
          <span class="text-xs text-stone-500 bg-stone-50 px-2 py-0.5 rounded border border-stone-200/60">
            {tech}
          </span>
        ))}
      </div>
      <a
        href={targetUrl}
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener noreferrer" : undefined}
        class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 hover:text-emerald-800 transition-colors"
        aria-label={`Lihat karya ${work.title}`}
      >
        <span>Lihat Karya</span>
        <ArrowUpRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
    </div>
  </div>
</article>

