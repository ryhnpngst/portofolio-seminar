---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/common/Container.astro";
import ReflectionArticleNav from "../../components/reflection/ReflectionArticleNav.astro";
import ReflectionIndicatorSection from "../../components/reflection/ReflectionIndicatorSection.astro";
import { parseReflectionTable } from "../../utils/reflectionParser";
import { getCollection, render } from "astro:content";
import { profile } from "../../data/profile";
import { ArrowLeft } from "lucide-astro";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const allReflections = await getCollection("reflections", ({ data }) => data.published);

  // Sort reflections
  const sorted = allReflections.sort((a, b) => {
    if (a.data.semester !== b.data.semester) {
      return a.data.semester - b.data.semester;
    }
    return a.data.order - b.data.order;
  });

  return sorted.map((entry, index) => {
    const slug = entry.id.split("/").pop() || entry.id;

    // Previous and Next entries for navigation
    const prevEntry = index > 0 ? sorted[index - 1] : undefined;
    const nextEntry = index < sorted.length - 1 ? sorted[index + 1] : undefined;

    const prev = prevEntry
      ? {
          title: prevEntry.data.title,
          slug: prevEntry.id.split("/").pop() || prevEntry.id,
          semester: prevEntry.data.semester,
        }
      : undefined;

    const next = nextEntry
      ? {
          title: nextEntry.data.title,
          slug: nextEntry.id.split("/").pop() || nextEntry.id,
          semester: nextEntry.data.semester,
        }
      : undefined;

    return {
      params: { slug },
      props: { entry, prev, next },
    };
  });
}

interface Props {
  entry: CollectionEntry<"reflections">;
  prev?: {
    title: string;
    slug: string;
    semester: number;
  };
  next?: {
    title: string;
    slug: string;
    semester: number;
  };
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

// Extract markdown content for structured card parsing
const rawMarkdown = entry.body || "";

const reflectionSections = parseReflectionTable(rawMarkdown);

const pageTitle = `${entry.data.title} | Refleksi PPG ${profile.name}`;
const pageDescription = entry.data.description;
const defaultImage = entry.data.semester === 1
  ? "/images/reflections/filosofi-pendidikan.jpeg"
  : "/images/works/modul-ajar.jpg";
const displayImage = entry.data.image || defaultImage;
---

<Layout title={pageTitle} description={pageDescription}>
  <article class="pt-8 md:pt-14 pb-16 md:pb-24 bg-white">
    <Container>
      <!-- Breadcrumb & Back Link -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <nav class="flex items-center gap-2 text-xs text-stone-500" aria-label="Breadcrumb">
          <a href="/" class="hover:text-emerald-700 transition-colors">Beranda</a>
          <span>/</span>
          <a href="/refleksi" class="hover:text-emerald-700 transition-colors">Refleksi</a>
          <span>/</span>
          <span class="text-stone-800 font-medium truncate max-w-[200px] sm:max-w-[300px]">
            {entry.data.shortTitle || entry.data.title}
          </span>
        </nav>

        <a
          href="/refleksi"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-stone-600 hover:text-emerald-700 transition-colors"
        >
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>Kembali ke Refleksi</span>
        </a>
      </div>

      <!-- Article Header -->
      <header class="max-w-[800px] mx-auto mb-10 text-center">

        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[2.75rem] font-bold text-stone-900 tracking-tight leading-[1.2] font-display mb-4">
          {entry.data.title}
        </h1>

        <p class="text-base sm:text-lg text-stone-600 leading-relaxed max-w-[65ch] mx-auto mb-6">
          {entry.data.description}
        </p>
      </header>

      <!-- Featured Image Banner -->
      {displayImage && (
        <div class="max-w-[860px] mx-auto mb-12 rounded-[20px] overflow-hidden border border-stone-200/90 shadow-sm aspect-[16/9] bg-stone-100">
          <img
            src={displayImage}
            alt={entry.data.imageAlt || entry.data.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <!-- Main Article Body: Cards Layout or Fallback Markdown -->
      <div class="max-w-[860px] mx-auto">
        {reflectionSections && reflectionSections.length > 0 ? (
          <div>

            <div class="space-y-4">
              {reflectionSections.map((sec) => (
                <ReflectionIndicatorSection section={sec} />
              ))}
            </div>
          </div>
        ) : (
          <div class="reflection-content prose prose-stone max-w-none text-stone-700 leading-relaxed mb-12">
            <Content />
          </div>
        )}

        <!-- Article Navigation (Previous / Next / Back) -->
        <div class="pt-6 border-t border-stone-200">
          <ReflectionArticleNav prev={prev} next={next} />
        </div>
      </div>
    </Container>
  </article>
</Layout>

<style is:global>
  /* Custom styling for the 4C Markdown tables rendered inside reflections */
  .reflection-content table {
    width: 100%;
    margin-top: 2rem;
    margin-bottom: 2rem;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: 14px;
    border: 1px solid #e7e5e4;
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.65;
    background-color: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .reflection-content thead {
    background-color: #ecfdf5;
    border-bottom: 2px solid #a7f3d0;
  }

  .reflection-content th {
    padding: 0.875rem 1rem;
    text-align: left;
    font-weight: 700;
    color: #065f46;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid #d1fae5;
  }

  .reflection-content td {
    padding: 1rem;
    vertical-align: top;
    border-bottom: 1px solid #f5f5f4;
    color: #44403c;
  }

  .reflection-content tr:last-child td {
    border-bottom: none;
  }

  .reflection-content tr:hover td {
    background-color: #fafaf9;
  }

  .reflection-content td:first-child {
    font-weight: 600;
    color: #047857;
    width: 25%;
    background-color: #fafaf9;
    border-right: 1px solid #f5f5f4;
  }

  .reflection-content td:nth-child(2) {
    font-weight: 500;
    color: #1c1917;
    width: 30%;
    border-right: 1px solid #f5f5f4;
  }

  .reflection-content td:nth-child(3) {
    width: 45%;
    color: #292524;
  }

  /* Responsive table wrapper on small screens */
  @media (max-width: 640px) {
    .reflection-content table {
      display: block;
      overflow-x: auto;
      white-space: normal;
    }
  }
</style>

