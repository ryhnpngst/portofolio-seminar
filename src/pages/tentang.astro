---
import Layout from "../layouts/Layout.astro";
import AboutHero from "../components/about/AboutHero.astro";
import AboutVisionMission from "../components/about/AboutVisionMission.astro";
import { profile } from "../data/profile";

const pageTitle = `Tentang Saya | ${profile.name}`;
const pageDescription = `Profil profesional, latar belakang pendidikan, visi dan misi pendidik, serta komitmen pengabdian ${profile.name} - ${profile.role} ${profile.field}.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <AboutHero />
  <AboutVisionMission />
</Layout>

